# BULK SHARE — Full-Stack Monorepo Environment Configuration (.env.example)

# Backend
PROJECT_NAME="BULK SHARE"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
DATABASE_URL="sqlite+aiosqlite:///./bulkshare.db"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://bulk-share.vercel.app"
DEMO_MODE=true
DEMO_JWT_SECRET="bulk-share-demo-secret-key-2026-milestone1"

# Frontend
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# Supabase Platform Keys
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
